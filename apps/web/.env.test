# E2E Test Environment Variables
NODE_ENV=test
PORT=3000
BASE_URL=http://localhost:3000

# API URL - Use web server URL for tests so Next.js rewrites work
# This ensures cookies are set on the correct domain
# Note: Don't include /api here - the API client paths already include it
NEXT_PUBLIC_API_URL=http://localhost:3000

# Database + Redis are set dynamically by testcontainers — do NOT hardcode here

# Test Admin Password (for initial setup)
E2E_ADMIN_PASSWORD=admin123

# Better Auth
BETTER_AUTH_SECRET=test-secret-key-for-e2e-testing-only
BETTER_AUTH_URL=http://localhost:3000
